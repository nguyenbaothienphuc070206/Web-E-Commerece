# Client-side
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ADMIN_SEED_SECRET=

# Auth
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email notifications (SMTP)
# Example: Gmail SMTP requires an App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER
SMTP_FROM=
# Optional: true/false (defaults to true when port=465)
SMTP_SECURE=

# Payments (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting (Upstash Redis) - recommended for production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
